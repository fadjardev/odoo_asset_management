<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- Multi-company -->
    <record id="rule_asset_company" model="ir.rule">
        <field name="name">Asset: multi-company</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_asset_location_company" model="ir.rule">
        <field name="name">Asset location: multi-company</field>
        <field name="model_id" ref="model_asset_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_asset_category_company" model="ir.rule">
        <field name="name">Asset category: multi-company</field>
        <field name="model_id" ref="model_asset_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <!-- User: what they hold, what is free to request, and their own paperwork -->
    <record id="rule_asset_user" model="ir.rule">
        <field name="name">Asset: own and available assets</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="domain_force">['|', ('holder_id.user_id', '=', user.id), ('state', '=', 'available')]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_user'))]"/>
    </record>
    <record id="rule_asset_assignment_user" model="ir.rule">
        <field name="name">Asset handover: own requests</field>
        <field name="model_id" ref="model_asset_assignment"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_user'))]"/>
    </record>
    <record id="rule_asset_maintenance_user" model="ir.rule">
        <field name="name">Asset maintenance: own reports and held assets</field>
        <field name="model_id" ref="model_asset_maintenance"/>
        <field name="domain_force">['|', ('reported_by_id', '=', user.id), ('asset_id.holder_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_user'))]"/>
    </record>

    <!-- Approver: assets of the departments they head, and of their direct reports -->
    <record id="rule_asset_approver" model="ir.rule">
        <field name="name">Asset: department assets</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="domain_force">[('approver_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_approver'))]"/>
    </record>
    <record id="rule_asset_assignment_approver" model="ir.rule">
        <field name="name">Asset handover: department employees and assets</field>
        <field name="model_id" ref="model_asset_assignment"/>
        <field name="domain_force">['|', ('approver_user_ids', 'in', [user.id]), ('asset_id.approver_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_approver'))]"/>
    </record>
    <record id="rule_asset_transfer_approver" model="ir.rule">
        <field name="name">Asset transfer: department assets</field>
        <field name="model_id" ref="model_asset_transfer"/>
        <field name="domain_force">[('asset_ids.approver_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_approver'))]"/>
    </record>
    <record id="rule_asset_maintenance_approver" model="ir.rule">
        <field name="name">Asset maintenance: department assets</field>
        <field name="model_id" ref="model_asset_maintenance"/>
        <field name="domain_force">[('asset_id.approver_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_approver'))]"/>
    </record>

    <!-- Officer and above: everything -->
    <record id="rule_asset_officer" model="ir.rule">
        <field name="name">Asset: all</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_officer'))]"/>
    </record>
    <record id="rule_asset_assignment_officer" model="ir.rule">
        <field name="name">Asset handover: all</field>
        <field name="model_id" ref="model_asset_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_officer'))]"/>
    </record>
    <record id="rule_asset_transfer_officer" model="ir.rule">
        <field name="name">Asset transfer: all</field>
        <field name="model_id" ref="model_asset_transfer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_officer'))]"/>
    </record>
    <record id="rule_asset_maintenance_officer" model="ir.rule">
        <field name="name">Asset maintenance: all</field>
        <field name="model_id" ref="model_asset_maintenance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_asset_officer'))]"/>
    </record>

</data>
</odoo>
