<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_transfer_view_list" model="ir.ui.view">
        <field name="name">asset.transfer.list</field>
        <field name="model">asset.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="location_src_id"/>
                <field name="location_dest_id"/>
                <field name="department_dest_id" optional="show"/>
                <field name="requested_by_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'" decoration-warning="state == 'approved'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="asset_transfer_view_form" model="ir.ui.view">
        <field name="name">asset.transfer.form</field>
        <field name="model">asset.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft'" groups="odoo_asset_management.group_asset_officer"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'" groups="odoo_asset_management.group_asset_approver"/>
                    <button name="action_done" type="object" string="Mark Moved" class="btn-primary"
                            invisible="state != 'approved'" groups="odoo_asset_management.group_asset_officer"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted', 'approved')" groups="odoo_asset_management.group_asset_officer"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'" groups="odoo_asset_management.group_asset_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_src_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="location_dest_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="department_dest_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                    <field name="asset_ids" readonly="state != 'draft'" options="{'no_create': True}">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="location_id"/>
                            <field name="department_id"/>
                            <field name="holder_id"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <field name="reason" placeholder="Why are these assets moving?" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="asset_transfer_view_search" model="ir.ui.view">
        <field name="name">asset.transfer.search</field>
        <field name="model">asset.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_ids"/>
                <field name="location_src_id"/>
                <field name="location_dest_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="to_move" string="To Move" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="asset_transfer_action" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">asset.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
