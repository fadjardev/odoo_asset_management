<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_maintenance_view_list" model="ir.ui.view">
        <field name="name">asset.maintenance.list</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="maintenance_type"/>
                <field name="date_request" optional="hide"/>
                <field name="date_scheduled"/>
                <field name="date_done" optional="show"/>
                <field name="vendor_id" optional="show"/>
                <field name="cost" optional="show" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'requested'" decoration-warning="state in ('scheduled', 'in_progress')"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="asset_maintenance_view_calendar" model="ir.ui.view">
        <field name="name">asset.maintenance.calendar</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <calendar date_start="date_scheduled" color="asset_id" mode="month" quick_create="0">
                <field name="asset_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="asset_maintenance_view_form" model="ir.ui.view">
        <field name="name">asset.maintenance.form</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary"
                            invisible="state != 'requested'" groups="odoo_asset_management.group_asset_officer"/>
                    <button name="action_start" type="object" string="Start Work" class="btn-primary"
                            invisible="state not in ('requested', 'scheduled')" groups="odoo_asset_management.group_asset_officer"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary"
                            invisible="state != 'in_progress'" groups="odoo_asset_management.group_asset_officer"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancel')" groups="odoo_asset_management.group_asset_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,scheduled,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'requested'" options="{'no_create': True}"/>
                            <field name="maintenance_type" readonly="state != 'requested'"/>
                            <field name="reported_by_id"/>
                            <field name="date_request" readonly="state != 'requested'"/>
                        </group>
                        <group>
                            <field name="date_scheduled" readonly="state in ('done', 'cancel')"/>
                            <field name="date_done"/>
                            <field name="vendor_id" readonly="state in ('done', 'cancel')"
                                   groups="odoo_asset_management.group_asset_officer"/>
                            <field name="cost" readonly="state in ('done', 'cancel')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="interval_days" invisible="maintenance_type != 'preventive'"
                                   groups="odoo_asset_management.group_asset_officer"/>
                            <field name="next_id" invisible="not next_id"/>
                        </group>
                    </group>
                    <label for="description"/>
                    <field name="description" placeholder="What is wrong, or what has to be done?"
                           readonly="state != 'requested'"/>
                    <group string="Result" invisible="state not in ('in_progress', 'done')">
                        <field name="resolution" readonly="state == 'done'"/>
                        <field name="condition_after" readonly="state == 'done'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="asset_maintenance_view_search" model="ir.ui.view">
        <field name="name">asset.maintenance.search</field>
        <field name="model">asset.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="vendor_id"/>
                <filter name="mine" string="My Reports" domain="[('reported_by_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', 'in', ('requested', 'scheduled', 'in_progress'))]"/>
                <filter name="corrective" string="Corrective" domain="[('maintenance_type', '=', 'corrective')]"/>
                <filter name="preventive" string="Preventive" domain="[('maintenance_type', '=', 'preventive')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="asset_maintenance_action" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">asset.maintenance</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Report a broken asset</p>
            <p>Asset officers schedule the repair, follow it up, and plan recurring preventive work.</p>
        </field>
    </record>

</odoo>
