<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_location_view_list" model="ir.ui.view">
        <field name="name">asset.location.list</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="location_type"/>
                <field name="responsible_id"/>
                <field name="asset_count"/>
            </list>
        </field>
    </record>

    <record id="asset_location_view_form" model="ir.ui.view">
        <field name="name">asset.location.form</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="location_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_location_view_search" model="ir.ui.view">
        <field name="name">asset.location.search</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name"/>
                <field name="responsible_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'location_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="asset_location_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">asset.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
