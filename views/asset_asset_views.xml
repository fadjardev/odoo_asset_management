<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_asset_view_list" model="ir.ui.view">
        <field name="name">asset.asset.list</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'disposed'" decoration-warning="state == 'maintenance'">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="location_id"/>
                <field name="department_id" optional="show"/>
                <field name="holder_id" optional="show"/>
                <field name="condition" optional="show"/>
                <field name="purchase_value" optional="hide" sum="Total"/>
                <field name="book_value" optional="show" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'available'" decoration-success="state == 'in_use'"
                       decoration-warning="state == 'maintenance'"/>
            </list>
        </field>
    </record>

    <record id="asset_asset_view_kanban" model="ir.ui.view">
        <field name="name">asset.asset.kanban</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false" group_delete="false" records_draggable="false">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="me-2">
                            <field name="image_128" widget="image" options="{'size': [64, 64], 'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold"/>
                            <field name="code" class="text-muted small"/>
                            <field name="location_id" class="small"/>
                            <field name="holder_id" class="small"/>
                            <field name="condition" widget="badge" class="mt-1"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="asset_asset_view_form" model="ir.ui.view">
        <field name="name">asset.asset.form</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'" groups="odoo_asset_management.group_asset_officer"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'available'" groups="odoo_asset_management.group_asset_officer"/>
                    <button name="action_compute_depreciation" type="object" string="Compute Depreciation"
                            invisible="state in ('draft', 'disposed')" groups="odoo_asset_management.group_asset_manager"/>
                    <button name="%(odoo_asset_management.action_report_asset_label)d" type="action" string="Print QR Label"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,in_use"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-handshake-o">
                            <field name="assignment_count" widget="statinfo" string="Handovers"/>
                        </button>
                        <button name="action_view_transfers" type="object" class="oe_stat_button" icon="fa-truck"
                                groups="odoo_asset_management.group_asset_approver">
                            <field name="transfer_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Disposed" bg_color="text-bg-danger" invisible="state != 'disposed'"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Laptop Lenovo ThinkPad T14"/></h1>
                        <h3><field name="code" class="text-muted"/></h3>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="category_id" readonly="state == 'disposed'"/>
                            <field name="brand"/>
                            <field name="asset_model"/>
                            <field name="serial_number"/>
                            <field name="condition"/>
                        </group>
                        <group string="Placement">
                            <field name="location_id" readonly="state not in ('draft', 'available')"/>
                            <field name="department_id" readonly="state not in ('draft', 'available')"/>
                            <field name="holder_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Value" name="value" groups="odoo_asset_management.group_asset_officer">
                            <group>
                                <group>
                                    <field name="purchase_date"/>
                                    <field name="purchase_value" readonly="state not in ('draft', 'available')"/>
                                    <field name="salvage_value" readonly="state not in ('draft', 'available')"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group>
                                    <field name="depreciation_method"/>
                                    <field name="useful_life_months" invisible="depreciation_method == 'none'"/>
                                    <field name="book_value"/>
                                </group>
                            </group>
                            <field name="depreciation_line_ids" readonly="1">
                                <list decoration-muted="posted">
                                    <field name="sequence"/>
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="accumulated"/>
                                    <field name="remaining_value"/>
                                    <field name="posted"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Handover History" name="assignments">
                            <field name="assignment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="date_handover"/>
                                    <field name="date_return"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="QR Code" name="qr" invisible="state == 'draft'">
                            <field name="qr_code" widget="image" options="{'size': [160, 160]}" readonly="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="asset_asset_view_search" model="ir.ui.view">
        <field name="name">asset.asset.search</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('serial_number', 'ilike', self)]"/>
                <field name="category_id"/>
                <field name="location_id" operator="child_of"/>
                <field name="department_id" operator="child_of"/>
                <field name="holder_id"/>
                <filter name="my_assets" string="My Assets" domain="[('holder_id.user_id', '=', uid)]"/>
                <separator/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="in_use" string="In Use" domain="[('state', '=', 'in_use')]"/>
                <filter name="maintenance" string="Under Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter name="not_disposed" string="Not Disposed" domain="[('state', '!=', 'disposed')]"/>
                <separator/>
                <filter name="damaged" string="Damaged or Lost" domain="[('condition', '!=', 'good')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_condition" string="Condition" context="{'group_by': 'condition'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="asset_asset_action" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">asset.asset</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_not_disposed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first asset</p>
            <p>Each asset gets a code from its category, a location, and later a holder.</p>
        </field>
    </record>

    <record id="asset_asset_dashboard_action" model="ir.actions.act_window">
        <field name="name">Asset Overview</field>
        <field name="res_model">asset.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_not_disposed': 1}</field>
    </record>

    <record id="asset_depreciation_line_view_list" model="ir.ui.view">
        <field name="name">asset.depreciation.line.list</field>
        <field name="model">asset.depreciation.line</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="posted">
                <field name="asset_id"/>
                <field name="date"/>
                <field name="amount" sum="Total"/>
                <field name="accumulated"/>
                <field name="remaining_value"/>
                <field name="posted"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="asset_depreciation_line_view_search" model="ir.ui.view">
        <field name="name">asset.depreciation.line.search</field>
        <field name="model">asset.depreciation.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <filter name="unposted" string="Not Posted" domain="[('posted', '=', False)]"/>
                <filter name="posted" string="Posted" domain="[('posted', '=', True)]"/>
                <group>
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="asset_depreciation_line_action" model="ir.actions.act_window">
        <field name="name">Depreciation Schedule</field>
        <field name="res_model">asset.depreciation.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_month': 1}</field>
    </record>

</odoo>
