<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_disposal_view_list" model="ir.ui.view">
        <field name="name">asset.disposal.list</field>
        <field name="model">asset.disposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="asset_id"/>
                <field name="method"/>
                <field name="book_value" sum="Total"/>
                <field name="sale_value" sum="Total"/>
                <field name="gain_loss" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'" decoration-warning="state == 'approved'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="asset_disposal_view_form" model="ir.ui.view">
        <field name="name">asset.disposal.form</field>
        <field name="model">asset.disposal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'" groups="odoo_asset_management.group_asset_manager"/>
                    <button name="action_done" type="object" string="Dispose" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="method" readonly="state != 'draft'"/>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="buyer_id" invisible="method == 'scrapped'" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="book_value"/>
                            <field name="sale_value" invisible="method != 'sold'" readonly="state == 'done'"/>
                            <field name="gain_loss"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Why is this asset leaving the register?" readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="asset_disposal_view_search" model="ir.ui.view">
        <field name="name">asset.disposal.search</field>
        <field name="model">asset.disposal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <group>
                    <filter name="group_method" string="Method" context="{'group_by': 'method'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="asset_disposal_action" model="ir.actions.act_window">
        <field name="name">Disposals</field>
        <field name="res_model">asset.disposal</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
