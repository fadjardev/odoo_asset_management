<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- The category code is put in front: IT-00001 -->
    <record id="seq_asset_asset" model="ir.sequence">
        <field name="name">Asset Code</field>
        <field name="code">asset.asset</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_asset_assignment" model="ir.sequence">
        <field name="name">Asset Handover</field>
        <field name="code">asset.assignment</field>
        <field name="prefix">BAST/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_asset_transfer" model="ir.sequence">
        <field name="name">Asset Transfer</field>
        <field name="code">asset.transfer</field>
        <field name="prefix">MUT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_asset_maintenance" model="ir.sequence">
        <field name="name">Asset Maintenance</field>
        <field name="code">asset.maintenance</field>
        <field name="prefix">MNT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_asset_audit" model="ir.sequence">
        <field name="name">Asset Stock Opname</field>
        <field name="code">asset.audit</field>
        <field name="prefix">SO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_asset_disposal" model="ir.sequence">
        <field name="name">Asset Disposal</field>
        <field name="code">asset.disposal</field>
        <field name="prefix">DSP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</data>
</odoo>
