<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <record id="cron_post_depreciation" model="ir.cron">
        <field name="name">Assets: post due depreciation</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_depreciation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="cron_schedule_preventive" model="ir.cron">
        <field name="name">Assets: schedule next preventive maintenance</field>
        <field name="model_id" ref="model_asset_maintenance"/>
        <field name="state">code</field>
        <field name="code">model._cron_schedule_preventive()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

</data>
</odoo>
